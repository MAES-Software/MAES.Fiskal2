{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/MAES.Fiskal2/MAES.Fiskal2.csproj",
                "--configuration",
                "Release"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Pack",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "pack",
                "${workspaceFolder}/MAES.Fiskal2/MAES.Fiskal2.csproj",
                "--configuration",
                "Release"
            ],
            "dependsOn": "Build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Push",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "nuget",
                "push",
                "${workspaceFolder}/MAES.Fiskal2/bin/Release/MAES.Fiskal2.0.1.3.nupkg",
                "--api-key",
                "${input:nugetApiKey}",
                "--source",
                "https://api.nuget.org/v3/index.json"
            ],
            "dependsOn": "Pack",
            "problemMatcher": []
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/MAES.Fiskal2.Tests",
                "--verbosity",
                "normal"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Example",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/MAES.Fiskal2.Example",
                "--configuration",
                "Debug"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run Example",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/MAES.Fiskal2.Example"
            ],
            "dependsOn": "Build Example",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "nugetApiKey",
            "type": "promptString",
            "description": "Enter your NuGet API Key",
            "password": true
        }
    ]
}